{
  "name": "@bytesickle/api-mock-services",
  "version": "1.0.0",
  "description": "Stand-ins for the outside world: the payment gateways, the identity checks, the email provider, the accounting service, the DNS provider, the messaging, the AI and storage services. One implementation, used by every project.",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./src/index.js"
    },
    "./harness": "./src/harness.js",
    "./spec": "./src/spec.js",
    "./ui": "./src/ui/index.js",
    "./providers/commerce": "./src/providers/commerce.js",
    "./providers/nigeria": "./src/providers/nigeria.js",
    "./providers/fintech": "./src/providers/fintech.js",
    "./providers/identity": "./src/providers/identity.js",
    "./providers/messaging": "./src/providers/messaging.js",
    "./providers/ai": "./src/providers/ai.js",
    "./providers/storage": "./src/providers/storage.js"
  },
  "bin": {
    "api-mock-services": "./bin/api-mock-services.js"
  },
  "files": [
    "src",
    "bin",
    "docker",
    "examples",
    "ARCHITECTURE.md",
    "ADOPTERS.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node bin/api-mock-services.js start",
    "list": "node bin/api-mock-services.js list",
    "test": "node --test test/*.test.js",
    "test:watch": "node --test --watch test/*.test.js",
    "lint": "node scripts/lint.js",
    "footprint": "node scripts/footprint.js",
    "routes": "node scripts/routes.js",
    "specs": "node scripts/check-specs.js",
    "openapi": "node scripts/openapi.js",
    "check": "npm run lint && npm test"
  },
  "keywords": [
    "mock",
    "mocks",
    "stub",
    "stripe",
    "paystack",
    "flutterwave",
    "monnify",
    "interswitch",
    "resend",
    "xero",
    "cloudflare",
    "youverify",
    "smileid",
    "identitypass",
    "onesignal",
    "fcm",
    "twilio",
    "termii",
    "whatsapp",
    "openai",
    "s3",
    "testing",
    "offline"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omeiza-workspace/api-mock-services.git"
  },
  "bugs": {
    "url": "https://github.com/omeiza-workspace/api-mock-services/issues"
  },
  "homepage": "https://github.com/omeiza-workspace/api-mock-services#readme",
  "author": "Okuta Omeiza",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/omeiza-workspace"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "sideEffects": false,
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  }
}
